<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#111827">
  <title>Mein Aufgabenplaner</title>
  <style>
    :root{--bg:#f4f5f7;--card:#fff;--text:#111827;--muted:#6b7280;--line:#e5e7eb}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Inter,Arial,sans-serif}.app{max-width:720px;margin:auto;padding:calc(16px + env(safe-area-inset-top)) 16px calc(32px + env(safe-area-inset-bottom))}header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:10px}h1{font-size:29px;margin:0}h2{font-size:19px;margin:0 0 12px}.sub,.meta,.time-hint{color:var(--muted);font-size:12px}.sub{font-size:14px;margin-top:3px}button{border:0;border-radius:12px;padding:11px 14px;font-weight:700;font-size:14px;background:#111827;color:#fff;cursor:pointer}button.secondary,.icon,.notes-button{background:#eef0f3;color:#111827}.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin:12px 0;box-shadow:0 2px 10px #00000008}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:#f8f9fa;border-radius:14px;padding:12px}.stat b{display:block;font-size:21px}.stat span{font-size:12px;color:var(--muted)}.tabs{display:flex;gap:7px;overflow:auto;margin:14px 0}.tab{white-space:nowrap;background:#fff;color:#374151;border:1px solid var(--line)}.tab.active{background:#111827;color:#fff}.task{display:flex;gap:12px;align-items:flex-start;padding:13px 0;border-bottom:1px solid var(--line);touch-action:pan-y}.task:last-child{border-bottom:0}.check,.check-mini{width:22px;height:22px;border:2px solid #cbd0d8;border-radius:50%;padding:0;background:#fff;flex:none}.done .check,.day-item.done .check-mini{background:#111827;border-color:#111827;color:#fff}.done .title,.day-item.done .day-item-title{text-decoration:line-through;color:#9ca3af}.task.done,.day-item.done{opacity:.52}.title,.day-item-title{font-weight:700}.meta{margin-top:5px}.pill{display:inline-block;padding:3px 7px;border-radius:8px;font-size:11px;font-weight:800;margin-right:5px}.A{background:#fee2e2;color:#b91c1c}.B{background:#fef3c7;color:#92400e}.C{background:#dcfce7;color:#166534}.actions{margin-left:auto;display:flex;gap:5px;position:relative}.task-menu{position:absolute;right:0;top:38px;z-index:30;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 8px 25px #0002;padding:5px;display:none;min-width:135px}.task-menu.show{display:block}.task-menu button{display:block;width:100%;text-align:left;background:#fff;color:#111827;padding:9px 10px;border-radius:8px;font-size:13px}.icon{padding:7px 9px}input,select,textarea{width:100%;padding:12px;border:1px solid #d7dbe1;border-radius:11px;font-size:15px;background:#fff;font-family:inherit}textarea{resize:vertical}label{display:block;font-size:12px;font-weight:700;color:#4b5563;margin:10px 0 5px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.empty,.day-empty{text-align:center;color:var(--muted);padding:25px 10px}.row{display:flex;gap:8px;margin-top:14px}.row>*{flex:1}.deadline{margin-top:12px;padding:13px 12px 11px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:15px}.deadline-head{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:8px}.deadline-count{font-size:24px;font-weight:900;line-height:1.05;margin-bottom:9px}.deadline-count small{font-size:12px;font-weight:700;color:var(--muted)}.bar{height:15px;background:#e5e7eb;border-radius:99px;overflow:hidden}.bar>i{display:block;height:100%;border-radius:99px;background:#16a34a;transition:width .4s}.bar.warn>i{background:#d97706}.bar.danger>i{background:#dc2626}.bar.over>i{background:#7f1d1d}.deadline-percent{text-align:right;font-size:11px;font-weight:800;margin-top:5px;color:#6b7280}.calendar-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}.calendar-nav{display:flex;gap:6px}.calendar-nav button{padding:8px 11px}.calendar-title{font-size:17px;font-weight:800}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.cal-weekday{text-align:center;font-size:10px;font-weight:800;color:#9ca3af;padding:4px 0}.cal-day{min-height:72px;background:#f8f9fa;border:1px solid #e5e7eb;border-radius:11px;padding:5px;overflow:hidden;cursor:pointer}.cal-day.empty{background:transparent;border-color:transparent;cursor:default}.cal-day.today{border:2px solid #111827}.cal-day.selected{box-shadow:0 0 0 2px #2563eb inset}.cal-day.drop-target{background:#eef6ff;border-color:#2563eb}.cal-num{font-size:11px;font-weight:800;color:#6b7280;margin-bottom:3px}.cal-task,.task-chip{background:#111827;color:#fff;border-radius:6px;padding:3px 4px;margin:2px 0;font-size:10px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:grab}.cal-task.done{opacity:.3;text-decoration:line-through}.cal-check{width:15px;height:15px;border:1.5px solid #fff;border-radius:50%;padding:0;background:transparent;color:#111827;flex:none;font-size:9px}.cal-task.done .cal-check{background:#fff}.unscheduled{display:flex;gap:7px;overflow:auto;padding:4px 1px 8px}.task-chip{flex:0 0 auto;background:#eef0f3;color:#111827;border-radius:10px;padding:8px 10px;font-size:12px;border:1px solid #dfe3e8;touch-action:pan-y}.calendar-help{font-size:12px;color:var(--muted);margin-top:8px}.day-view{margin-top:14px;padding:14px;background:#f8f9fa;border:1px solid #e5e7eb;border-radius:15px}.day-view-head{display:flex;justify-content:space-between}.day-view-title{font-size:16px;font-weight:800}.day-view-stats{font-size:11px;color:var(--muted);margin-top:3px}.timeline{margin-top:12px;border-top:1px solid #e5e7eb}.time-row{display:grid;grid-template-columns:54px 1fr;min-height:54px;border-bottom:1px solid #eef0f3}.time-label{font-size:11px;color:#9ca3af;padding:7px 5px 0 0;text-align:right}.time-slot{padding:5px 0}.time-task{display:flex;gap:8px;align-items:flex-start;background:#111827;color:#fff;border-radius:10px;padding:8px 10px;margin:1px 0;font-size:12px;font-weight:700}.time-task.done{opacity:.3;text-decoration:line-through}.time-task small{display:block;font-weight:500;opacity:.75;margin-top:2px}.time-check{width:19px;height:19px;border:1.5px solid #fff;border-radius:50%;padding:0;background:transparent;color:#111827;flex:none}.time-task.done .time-check{background:#fff}.day-item{display:flex;gap:10px;align-items:center;padding:10px 0;border-top:1px solid #e5e7eb}.day-item-meta{font-size:11px;color:var(--muted);margin-top:2px}.notes-button{margin-top:7px;padding:6px 9px;font-size:11px;border-radius:9px}.modal{position:fixed;inset:0;background:#0007;display:none;align-items:flex-end;justify-content:center;padding:12px;z-index:100}.modal.show{display:flex}.sheet{width:min(720px,100%);background:#fff;border-radius:22px;padding:18px;max-height:90vh;overflow:auto}@media(min-width:700px){.modal{align-items:center}.sheet{max-height:80vh}}
  </style>
</head>
<body>
<div class="app"><header><div><h1>Meine Aufgaben</h1><div class="sub" id="date"></div></div><button type="button" onclick="openModal()">＋ Aufgabe</button></header>
<div class="card"><h2>Dein Überblick</h2><div class="stats"><div class="stat"><b id="openCount">0</b><span>offen</span></div><div class="stat"><b id="urgentCount">0</b><span>dringend</span></div><div class="stat"><b id="timeCount">0</b><span>Min. offen</span></div></div></div>
<div class="card"><div class="calendar-head"><div class="calendar-title" id="calendarTitle"></div><div class="calendar-nav"><button type="button" class="secondary" aria-label="Vorheriger Monat" onclick="changeMonth(-1)">‹</button><button type="button" class="secondary" aria-label="Nächster Monat" onclick="changeMonth(1)">›</button></div></div><div id="calendarGrid"></div><div class="calendar-help">Tippe auf einen Tag für die Tagesansicht. Auf dem Handy eine ungeplante Aufgabe ca. 0,5 Sekunden gedrückt halten und auf einen Tag ziehen.</div><div id="unscheduledWrap"></div><div id="dayView"></div></div>
<div class="card"><h2>Was passt jetzt?</h2><div class="sub">Sag mir, wie viel Zeit du gerade hast.</div><div class="row"><input id="minutes" type="number" min="5" step="5" aria-label="Verfügbare Minuten" placeholder="z. B. 45"><button type="button" onclick="suggest()">Vorschlag</button></div><div id="suggestion"></div></div>
<div class="tabs"><button type="button" class="tab active" onclick="setFilter('all',this)">Alle</button><button type="button" class="tab" onclick="setFilter('today',this)">Heute</button><button type="button" class="tab" onclick="setFilter('urgent',this)">Dringend</button><button type="button" class="tab" onclick="setFilter('open',this)">Offen</button></div><div class="card"><div id="tasks"></div></div></div>
<div class="modal" id="deleteModal"><div class="sheet"><h2>Aufgabe wirklich löschen?</h2><div class="sub" id="deleteQuestion"></div><div class="row"><button type="button" class="secondary" onclick="closeDeleteModal()">Abbrechen</button><button type="button" onclick="confirmDelete()">Löschen</button></div></div></div>
<div class="modal" id="notesModal"><div class="sheet"><h2 id="notesTitle">Notizen</h2><textarea id="notesText" rows="10" aria-label="Notizen"></textarea><div class="row"><button type="button" class="secondary" onclick="closeNotes()">Abbrechen</button><button type="button" onclick="saveNotes()">Speichern</button></div></div></div>
<div class="modal" id="modal"><div class="sheet"><h2 id="modalTitle">Aufgabe hinzufügen</h2><label for="fTitle">Was musst du erledigen?</label><input id="fTitle" placeholder="z. B. Staubsaugen"><label for="fNotes">Notizen</label><textarea id="fNotes" rows="4" placeholder="Einkaufsliste, Gesprächspunkte oder andere Notizen"></textarea><div class="grid"><div><label for="fPriority">Priorität</label><select id="fPriority"><option value="A">A – wichtig & dringend</option><option value="B" selected>B – wichtig</option><option value="C">C – kann warten</option></select></div><div><label for="fDuration">Dauer (Minuten)</label><input id="fDuration" type="number" min="5" value="30"></div><div><label for="fPlanned">Erledigen am</label><input id="fPlanned" type="date"></div><div><label for="fTime">Uhrzeit</label><input id="fTime" type="time"><div class="time-hint">Optional – nur bei einem geplanten Tag.</div></div><div><label for="fDue">Frist</label><input id="fDue" type="date"></div><div><label for="fCategory">Kategorie</label><select id="fCategory"><option>Privat</option><option>Haushalt</option><option>Arbeit</option><option>Finanzen</option><option>Termine</option><option>Sonstiges</option></select></div></div><div class="row"><button type="button" class="secondary" onclick="closeModal()">Abbrechen</button><button type="button" onclick="saveTask()" id="saveTaskButton">Speichern</button></div></div></div>
<script>
const KEY='mein-aufgabenplaner-v1';
function loadTasks(){try{const saved=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(saved)?saved:[]}catch(e){localStorage.removeItem(KEY);return []}}
let tasks=loadTasks().map(t=>({...t,id:String(t.id||crypto.randomUUID()),done:Boolean(t.done),time:typeof t.time==='string'?t.time:''})),filter='all',editTaskId=null,pendingDeleteId=null,notesId=null;
let calendarDate=new Date();calendarDate.setDate(1);let selectedDate=new Date();selectedDate.setHours(0,0,0,0);
const dayStart=()=>{const d=new Date();d.setHours(0,0,0,0);return d};
function toISO(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function parseDate(s){return /^\d{4}-\d{2}-\d{2}$/.test(s||'')?new Date(s+'T12:00:00'):null}
function daysUntil(s){const date=parseDate(s);if(!date)return 9999;const now=parseDate(toISO(dayStart()));return Math.round((date-now)/86400000)}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function dueText(t){if(!t.due)return'Keine Frist';const d=daysUntil(t.due);return d<0?'Überfällig':d===0?'Heute':d===1?'Morgen':'bis '+parseDate(t.due).toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit'})}
function urgent(t){return !t.done&&(t.priority==='A'||daysUntil(t.due)<=1)}
function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}
function deadlineHTML(t){if(!t.due)return'';const due=new Date(t.due+'T23:59:59'),start=t.createdAt?new Date(t.createdAt):new Date(dayStart().getTime()-86400000),total=Math.max(1,due-start),pct=Math.min(100,Math.max(0,(Date.now()-start)/total*100)),days=daysUntil(t.due),cls=days<0?'over':days<=1?'danger':days<=3?'warn':'',label=days<0?Math.abs(days)+' Tag'+(Math.abs(days)===1?'':'e')+' überfällig':days===0?'HEUTE FÄLLIG':days===1?'NOCH 1 TAG':'NOCH '+days+' TAGE';return `<div class="deadline"><div class="deadline-head"><span>${days<0?'Frist überschritten':days===0?'Heute ist die Deadline':days===1?'Morgen ist die Deadline':'Bis zur Deadline'}</span><span>${Math.round(pct)} % verstrichen</span></div><div class="deadline-count">${label} <small>· ${parseDate(t.due).toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric'})}</small></div><div class="bar ${cls}"><i style="width:${pct}%"></i></div><div class="deadline-percent">${Math.round(pct)} % der verfügbaren Zeit sind vorbei</div></div>`}
function renderCalendar(){const y=calendarDate.getFullYear(),m=calendarDate.getMonth(),first=new Date(y,m,1),start=(first.getDay()+6)%7,last=new Date(y,m+1,0).getDate();document.getElementById('calendarTitle').textContent=calendarDate.toLocaleDateString('de-DE',{month:'long',year:'numeric'});let h='<div class="calendar-grid">';['Mo','Di','Mi','Do','Fr','Sa','So'].forEach(x=>h+='<div class="cal-weekday">'+x+'</div>');for(let i=0;i<start;i++)h+='<div class="cal-day empty"></div>';for(let d=1;d<=last;d++){const iso=y+'-'+String(m+1).padStart(2,'0')+'-'+String(d).padStart(2,'0'),dayTasks=tasks.filter(t=>t.planned===iso),cls=['cal-day',iso===toISO(dayStart())?'today':'',iso===toISO(selectedDate)?'selected':''].filter(Boolean).join(' ');h+=`<div class="${cls}" data-date="${iso}" onclick="selectDay('${iso}')" ondragover="allowDrop(event)" ondragenter="dragEnter(event)" ondragleave="dragLeave(event)" ondrop="dropTask(event,'${iso}')"><div class="cal-num">${d}</div>`;dayTasks.slice(0,4).forEach(t=>h+=`<div class="cal-task ${t.done?'done':''}" draggable="true" ondragstart="dragStart(event,'${t.id}')"><button type="button" class="cal-check" aria-label="Aufgabe abhaken" onclick="event.preventDefault();event.stopPropagation();toggleTask('${t.id}')">${t.done?'✓':''}</button><span>${t.time?esc(t.time)+' ':''}${esc(t.title)}</span></div>`);if(dayTasks.length>4)h+=`<div class="cal-task">+${dayTasks.length-4} weitere</div>`;h+='</div>'}h+='</div>';document.getElementById('calendarGrid').innerHTML=h;const uns=tasks.filter(t=>!t.planned&&!t.done);document.getElementById('unscheduledWrap').innerHTML=uns.length?'<div class="calendar-help">Noch nicht eingeplant:</div><div class="unscheduled">'+uns.map(t=>`<div class="task-chip" draggable="true" ondragstart="dragStart(event,'${t.id}')">${esc(t.title)}</div>`).join('')+'</div>':'';renderDayView()}
function selectDay(iso){selectedDate=parseDate(iso);renderCalendar()}
function renderDayView(){const iso=toISO(selectedDate),arr=tasks.filter(t=>t.planned===iso).sort((a,b)=>(a.time||'99:99').localeCompare(b.time||'99:99')),done=arr.filter(t=>t.done).length,total=arr.reduce((s,t)=>s+(+t.duration||0),0),open=arr.filter(t=>!t.done).reduce((s,t)=>s+(+t.duration||0),0);let h=`<div class="day-view"><div class="day-view-title">Tagesansicht · ${selectedDate.toLocaleDateString('de-DE',{weekday:'long',day:'2-digit',month:'long',year:'numeric'})}</div><div class="day-view-stats">${arr.length} Aufgaben · ${done} erledigt · ${total} Min. geplant · ${open} Min. offen</div>`;const timed=arr.filter(t=>t.time),hours=[...new Set(timed.map(t=>parseInt(t.time,10)))].sort((a,b)=>a-b);if(timed.length){h+='<div class="timeline">';hours.forEach(hour=>{const slot=timed.filter(t=>parseInt(t.time,10)===hour);h+=`<div class="time-row"><div class="time-label">${String(hour).padStart(2,'0')}:00</div><div class="time-slot">${slot.map(dayTask).join('')}</div></div>`});h+='</div>'}const noTime=arr.filter(t=>!t.time);if(noTime.length)h+='<div>'+noTime.map(t=>`<div class="day-item ${t.done?'done':''}"><button type="button" class="check-mini" onclick="toggleTask('${t.id}')">${t.done?'✓':''}</button><div style="flex:1"><div class="day-item-title">${esc(t.title)}</div><div class="day-item-meta">${esc(t.category)} · ${t.duration||0} Min. · Priorität ${t.priority}</div>${notesButton(t)}</div><button type="button" class="icon" aria-label="Aufgabe bearbeiten" onclick="editTask('${t.id}')">⋯</button></div>`).join('')+'</div>';if(!arr.length)h+='<div class="day-empty">Für diesen Tag sind noch keine Aufgaben eingeplant.</div>';document.getElementById('dayView').innerHTML=h+'</div>'}
function dayTask(t){return `<div class="time-task ${t.done?'done':''}"><button type="button" class="time-check" onclick="toggleTask('${t.id}')">${t.done?'✓':''}</button><div style="flex:1"><span>${esc(t.title)}</span><small>${esc(t.time)} · ${t.duration||0} Min. · ${esc(t.category)}</small>${notesButton(t)}</div><button type="button" class="icon" aria-label="Aufgabe bearbeiten" onclick="editTask('${t.id}')">⋯</button></div>`}function notesButton(t){return t.notes?`<button type="button" class="notes-button" onclick="showNotes('${t.id}')">📝 Notizen</button>`:''}
function changeMonth(n){calendarDate.setMonth(calendarDate.getMonth()+n);renderCalendar()}function dragStart(e,id){e.stopPropagation();e.dataTransfer.setData('text/plain',id)}function allowDrop(e){e.preventDefault()}function dragEnter(e){e.preventDefault();e.currentTarget.classList.add('drop-target')}function dragLeave(e){e.currentTarget.classList.remove('drop-target')}function dropTask(e,iso){e.preventDefault();document.querySelectorAll('.drop-target').forEach(x=>x.classList.remove('drop-target'));const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.planned=iso;selectedDate=parseDate(iso);save()}}
function toggleTask(id){const t=tasks.find(x=>x.id===id);if(t){t.done=!t.done;save()}}function setFilter(f,btn){filter=f;document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));btn.classList.add('active');render()}function toggleMenu(id){document.querySelectorAll('.task-menu').forEach(m=>m.classList.remove('show'));document.getElementById('menu-'+id)?.classList.toggle('show')}document.addEventListener('click',e=>{if(!e.target.closest('.actions'))document.querySelectorAll('.task-menu').forEach(m=>m.classList.remove('show'))});
function openModal(){editTaskId=null;document.getElementById('modalTitle').textContent='Aufgabe hinzufügen';document.getElementById('saveTaskButton').textContent='Speichern';['fTitle','fNotes','fPlanned','fTime','fDue'].forEach(id=>document.getElementById(id).value='');document.getElementById('fPriority').value='B';document.getElementById('fDuration').value=30;document.getElementById('fCategory').value='Privat';document.getElementById('modal').classList.add('show');document.getElementById('fTitle').focus()}function closeModal(){document.getElementById('modal').classList.remove('show');editTaskId=null}function editTask(id){const t=tasks.find(x=>x.id===id);if(!t)return;editTaskId=id;document.getElementById('modalTitle').textContent='Aufgabe bearbeiten';document.getElementById('saveTaskButton').textContent='Änderungen speichern';['Title','Notes','Priority','Duration','Planned','Time','Due','Category'].forEach(k=>document.getElementById('f'+k).value=t[k.toLowerCase()]||({Priority:'B',Duration:30,Category:'Privat'}[k]||''));document.getElementById('modal').classList.add('show')}
function saveTask(){const title=document.getElementById('fTitle').value.trim();if(!title)return alert('Bitte eine Aufgabe eingeben.');const planned=document.getElementById('fPlanned').value,data={title,notes:document.getElementById('fNotes').value.trim(),priority:document.getElementById('fPriority').value,duration:Math.max(5,+document.getElementById('fDuration').value||30),planned,time:planned?document.getElementById('fTime').value:'',due:document.getElementById('fDue').value,category:document.getElementById('fCategory').value};if(editTaskId){const t=tasks.find(x=>x.id===editTaskId);if(t)Object.assign(t,data)}else tasks.push({id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),done:false,createdAt:new Date().toISOString(),...data});if(planned){selectedDate=parseDate(planned);calendarDate=new Date(selectedDate.getFullYear(),selectedDate.getMonth(),1)}closeModal();save()}
function requestDelete(id){const t=tasks.find(x=>x.id===id);if(!t)return;pendingDeleteId=id;document.getElementById('deleteQuestion').textContent='„'+t.title+'“ wird dauerhaft entfernt. Bist du sicher?';document.getElementById('deleteModal').classList.add('show')}function closeDeleteModal(){pendingDeleteId=null;document.getElementById('deleteModal').classList.remove('show')}function confirmDelete(){tasks=tasks.filter(x=>x.id!==pendingDeleteId);closeDeleteModal();save()}function showNotes(id){const t=tasks.find(x=>x.id===id);if(!t)return;notesId=id;document.getElementById('notesTitle').textContent='Notizen · '+t.title;document.getElementById('notesText').value=t.notes||'';document.getElementById('notesModal').classList.add('show')}function closeNotes(){document.getElementById('notesModal').classList.remove('show');notesId=null}function saveNotes(){const t=tasks.find(x=>x.id===notesId);if(t){t.notes=document.getElementById('notesText').value.trim();save()}closeNotes()}
function suggest(){const mins=+document.getElementById('minutes').value||0,open=tasks.filter(t=>!t.done).sort((a,b)=>({A:0,B:1,C:2}[a.priority]-{A:0,B:1,C:2}[b.priority])||(+a.duration||0)-(+b.duration||0)),fit=open.filter(t=>(+t.duration||0)<=mins);document.getElementById('suggestion').innerHTML=mins?(fit.length?'<div class="deadline"><b>'+esc(fit[0].title)+'</b><div class="sub">'+fit[0].duration+' Min. · Priorität '+fit[0].priority+'</div></div>':'<div class="sub" style="margin-top:12px">Keine offene Aufgabe passt in die angegebene Zeit.</div>'):'<div class="sub" style="margin-top:12px">Gib zuerst eine Minutenanzahl ein.</div>'}
function render(){const open=tasks.filter(t=>!t.done);document.getElementById('openCount').textContent=open.length;document.getElementById('urgentCount').textContent=open.filter(urgent).length;document.getElementById('timeCount').textContent=open.reduce((a,t)=>a+(+t.duration||0),0);const list=tasks.filter(t=>filter==='today'?!t.done&&(t.planned===toISO(dayStart())||daysUntil(t.due)===0):filter==='urgent'?urgent(t):filter==='open'?!t.done:true).sort((a,b)=>(a.done-b.done)||({A:0,B:1,C:2}[a.priority]-{A:0,B:1,C:2}[b.priority])||(daysUntil(a.due)-daysUntil(b.due)));document.getElementById('tasks').innerHTML=list.length?list.map(t=>`<div class="task ${t.done?'done':''}" draggable="true" ondragstart="dragStart(event,'${t.id}')"><button type="button" class="check" aria-label="Aufgabe abhaken" onclick="toggleTask('${t.id}')">${t.done?'✓':''}</button><div style="flex:1"><div class="title">${esc(t.title)}</div><div class="meta"><span class="pill ${t.priority}">${t.priority}</span>${esc(t.category)} · ${t.duration} Min. · ${dueText(t)}${t.planned?' · geplant '+parseDate(t.planned).toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit'}):''}${t.time?' · '+esc(t.time):''}</div>${notesButton(t)}${deadlineHTML(t)}</div><div class="actions"><button type="button" class="icon" aria-label="Aufgabenmenü" onclick="toggleMenu('${t.id}')">⋯</button><div class="task-menu" id="menu-${t.id}"><button type="button" onclick="editTask('${t.id}')">Bearbeiten</button><button type="button" onclick="requestDelete('${t.id}')">Löschen</button></div></div></div>`).join(''):'<div class="empty">Noch keine Aufgaben. Füge deine erste Aufgabe hinzu.</div>';renderCalendar()}
document.getElementById('date').textContent=dayStart().toLocaleDateString('de-DE',{weekday:'long',day:'2-digit',month:'long'});render();
</script></body></html>
